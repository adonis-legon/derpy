#!/bin/bash
# Example User Setup Script for Derpy Daemon
#
# This script demonstrates how to set up users for derpy daemon access.
# It can be customized for different deployment scenarios.
#
# Usage:
#   sudo bash setup-user.sh.example <username>
#
# Or customize and use in your own automation:
#   - Ansible playbooks
#   - Chef recipes
#   - Puppet manifests
#   - Cloud-init scripts
#   - Docker container initialization

set -e

# Configuration
# =============

# Group name for derpy access
DERPY_GROUP="derpy"

# Socket path to verify
SOCKET_PATH="/var/run/derpy.sock"

# Whether to verify daemon is running
VERIFY_DAEMON=true

# Whether to show detailed output
VERBOSE=true

# Colors for output (disable if piping to logs)
USE_COLORS=true

if [ "$USE_COLORS" = true ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

# Helper Functions
# ================

log_info() {
    if [ "$VERBOSE" = true ]; then
        echo -e "${BLUE}[INFO]${NC} $1"
    fi
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

check_root() {
    if [ "$EUID" -ne 0 ]; then
        log_error "This script must be run as root"
        echo "Please run: sudo $0 $*"
        exit 1
    fi
}

check_user_exists() {
    local username="$1"
    if ! id "$username" &>/dev/null; then
        log_error "User '$username' does not exist"
        return 1
    fi
    return 0
}

check_group_exists() {
    local groupname="$1"
    if ! getent group "$groupname" > /dev/null 2>&1; then
        log_error "Group '$groupname' does not exist"
        return 1
    fi
    return 0
}

is_user_in_group() {
    local username="$1"
    local groupname="$2"
    if id -nG "$username" | grep -qw "$groupname"; then
        return 0
    fi
    return 1
}

add_user_to_group() {
    local username="$1"
    local groupname="$2"
    
    log_info "Adding user '$username' to group '$groupname'..."
    
    if usermod -aG "$groupname" "$username"; then
        log_success "User '$username' added to group '$groupname'"
        return 0
    else
        log_error "Failed to add user '$username' to group '$groupname'"
        return 1
    fi
}

verify_daemon_running() {
    log_info "Verifying daemon is running..."
    
    # Check if socket exists
    if [ ! -S "$SOCKET_PATH" ]; then
        log_warning "Daemon socket not found at $SOCKET_PATH"
        log_warning "The daemon may not be running"
        return 1
    fi
    
    # Check socket permissions
    local perms=$(stat -c "%a" "$SOCKET_PATH" 2>/dev/null || stat -f "%Lp" "$SOCKET_PATH" 2>/dev/null)
    local group=$(stat -c "%G" "$SOCKET_PATH" 2>/dev/null || stat -f "%Sg" "$SOCKET_PATH" 2>/dev/null)
    
    log_info "Socket permissions: $perms"
    log_info "Socket group: $group"
    
    if [ "$perms" != "660" ]; then
        log_warning "Socket permissions are $perms (expected 660)"
    fi
    
    if [ "$group" != "$DERPY_GROUP" ]; then
        log_warning "Socket group is $group (expected $DERPY_GROUP)"
    fi
    
    # Check if systemd service is running (if systemd is available)
    if command -v systemctl &> /dev/null; then
        if systemctl is-active --quiet derpyd; then
            log_success "Daemon service is running"
            return 0
        else
            log_warning "Daemon service is not active"
            return 1
        fi
    fi
    
    return 0
}

show_next_steps() {
    local username="$1"
    
    echo ""
    echo "=========================================="
    echo "  Next Steps for User: $username"
    echo "=========================================="
    echo ""
    echo "1. The user must log out and log back in for group changes to take effect"
    echo ""
    echo "2. After logging back in, verify group membership:"
    echo "   ${GREEN}groups${NC}"
    echo "   (should show '$DERPY_GROUP' in the list)"
    echo ""
    echo "3. Test daemon access:"
    echo "   ${GREEN}derpy build . -f Dockerfile -t test:latest${NC}"
    echo ""
    echo "Alternative for SSH sessions (no logout required):"
    echo "   ${GREEN}newgrp $DERPY_GROUP${NC}"
    echo "   (starts a new shell with updated groups)"
    echo ""
}

# Main Script
# ===========

main() {
    # Check arguments
    if [ $# -eq 0 ]; then
        log_error "No username provided"
        echo ""
        echo "Usage: sudo $0 <username> [username2] [username3] ..."
        echo ""
        echo "Examples:"
        echo "  sudo $0 alice"
        echo "  sudo $0 alice bob charlie"
        echo ""
        exit 1
    fi
    
    # Check if running as root
    check_root "$@"
    
    echo ""
    echo "=========================================="
    echo "  Derpy Daemon User Setup"
    echo "=========================================="
    echo ""
    
    # Check if derpy group exists
    if ! check_group_exists "$DERPY_GROUP"; then
        log_error "Derpy daemon may not be installed"
        echo "Please install the daemon first:"
        echo "  sudo scripts/install-daemon.sh"
        exit 1
    fi
    
    log_success "Derpy group exists"
    
    # Verify daemon is running (optional)
    if [ "$VERIFY_DAEMON" = true ]; then
        verify_daemon_running || log_warning "Daemon verification failed (continuing anyway)"
    fi
    
    # Process each username
    local success_count=0
    local skip_count=0
    local fail_count=0
    
    for username in "$@"; do
        echo ""
        log_info "Processing user: $username"
        
        # Check if user exists
        if ! check_user_exists "$username"; then
            log_error "Skipping user '$username' (does not exist)"
            ((fail_count++))
            continue
        fi
        
        # Check if already in group
        if is_user_in_group "$username" "$DERPY_GROUP"; then
            log_warning "User '$username' is already in group '$DERPY_GROUP'"
            ((skip_count++))
            continue
        fi
        
        # Add user to group
        if add_user_to_group "$username" "$DERPY_GROUP"; then
            # Verify addition
            if is_user_in_group "$username" "$DERPY_GROUP"; then
                log_success "Verified: User '$username' is now in group '$DERPY_GROUP'"
                ((success_count++))
            else
                log_error "Verification failed for user '$username'"
                ((fail_count++))
            fi
        else
            ((fail_count++))
        fi
    done
    
    # Summary
    echo ""
    echo "=========================================="
    echo "  Summary"
    echo "=========================================="
    echo ""
    echo "Users processed: $#"
    echo "Successfully added: $success_count"
    echo "Already in group: $skip_count"
    echo "Failed: $fail_count"
    echo ""
    
    # Show next steps if any users were added
    if [ $success_count -gt 0 ]; then
        if [ $success_count -eq 1 ]; then
            # Single user - show personalized message
            for username in "$@"; do
                if is_user_in_group "$username" "$DERPY_GROUP"; then
                    show_next_steps "$username"
                    break
                fi
            done
        else
            # Multiple users - show general message
            echo "All users must log out and log back in for changes to take effect."
            echo ""
            echo "After logging back in, users can verify access with:"
            echo "  ${GREEN}groups${NC}  (should show '$DERPY_GROUP')"
            echo "  ${GREEN}derpy build . -f Dockerfile -t test:latest${NC}"
            echo ""
        fi
    fi
    
    # Exit with appropriate code
    if [ $fail_count -gt 0 ]; then
        exit 1
    else
        exit 0
    fi
}

# Customization Examples
# ======================

# Example 1: Batch user setup from a file
# ----------------------------------------
# Create a file 'users.txt' with one username per line, then:
#
# while IFS= read -r username; do
#     if [ -n "$username" ]; then
#         main "$username"
#     fi
# done < users.txt

# Example 2: Integration with LDAP/Active Directory
# --------------------------------------------------
# Get users from LDAP and add them to derpy group:
#
# ldapsearch -x -LLL -b "ou=users,dc=example,dc=com" "(memberOf=cn=developers,ou=groups,dc=example,dc=com)" uid | \
#     grep "^uid:" | \
#     awk '{print $2}' | \
#     while read username; do
#         main "$username"
#     done

# Example 3: Cloud-init integration
# ----------------------------------
# Add to your cloud-init configuration:
#
# runcmd:
#   - curl -o /tmp/setup-user.sh https://example.com/setup-user.sh
#   - chmod +x /tmp/setup-user.sh
#   - /tmp/setup-user.sh ubuntu
#   - /tmp/setup-user.sh admin

# Example 4: Ansible playbook integration
# ----------------------------------------
# - name: Add users to derpy group
#   user:
#     name: "{{ item }}"
#     groups: derpy
#     append: yes
#   loop:
#     - alice
#     - bob
#     - charlie

# Example 5: Docker container initialization
# -------------------------------------------
# In your Dockerfile or entrypoint script:
#
# RUN groupadd -r derpy && \
#     usermod -aG derpy myuser

# Run the main function
main "$@"
